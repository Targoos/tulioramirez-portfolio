# ─────────────────────────────────────────────
#  Environment variables — copy to .env.local
#  and fill in real values before running.
#  NEVER commit .env.local to version control.
# ─────────────────────────────────────────────

# Required: Google Gemini API key.
# Used exclusively by the /api/chat Edge Function (server-side only).
# Get your key at: https://aistudio.google.com/app/apikey
# IMPORTANT: This value must only be set in the Vercel dashboard
#            (Settings → Environment Variables). Setting it here
#            is only for local development via `vercel dev`.
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: The public URL of this app (used for canonical links / OG tags).
# In production this is set automatically by Vercel.
# Example: https://tulioramirez.com
VITE_APP_URL="http://localhost:3000"
